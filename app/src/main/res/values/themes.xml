<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SkylineControlCenter" parent="android:Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.SkylineControlCenter.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0810</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SkylineControlCenter</item>
    </style>
</resources>
